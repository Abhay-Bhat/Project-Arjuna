# Dependencies
node_modules/

# Android build/copy artifacts — android/.gitignore covers build outputs;
# these two are Android-specific credentials/generated files it doesn't.
android/app/google-services.json
www/

# Firebase credentials — injected at deploy time via GitHub Actions secrets
js/firebase-config.js

# Local env file — import into Netlify dashboard, never commit
.env

# Personal financial data — never commit to a public repo
*.xlsx
*.xls
~$*

# Claude AI configuration
.claude/

# Test / scratch files
test-*.html
CALENDAR_FIX_SUMMARY.md

# OS
.DS_Store
Thumbs.db

# Temp
*.tmp
*.log
